function JunkSelector({ onConfirm }) {
  const [selected, setSelected] = useState([]);
  const [size, setSize] = useState(null);

  function toggle(val) {
    setSelected(s => s.includes(val) ? s.filter(x => x !== val) : [...s, val]);
  }

  const ready = selected.length > 0 && size !== null;

  return (
    <div style={{ marginBottom: 16 }}>
      <div style={{ fontSize: 11, letterSpacing: "0.1em", textTransform: "uppercase", color: GOLD, marginBottom: 10 }}>
        What are we hauling?
      </div>
      <div style={{ display: "flex", flexDirection: "column", gap: 7, marginBottom: 16 }}>
        {JUNK_TYPES.map(opt => (
          <button key={opt.value} onClick={() => toggle(opt.value)} style={{
            background: selected.includes(opt.value) ? GOLD : "transparent",
            color: selected.includes(opt.value) ? BLACK : WHITE,
            border: `1px solid ${selected.includes(opt.value) ? GOLD : BORDER}`,
            padding: "11px 16px", fontSize: 13.5, cursor: "pointer",
            textAlign: "left", borderRadius: 4, fontFamily: "inherit",
            fontWeight: selected.includes(opt.value) ? 600 : 400,
            transition: "all 0.15s"
          }}>
            {selected.includes(opt.value) ? "✓ " : ""}{opt.label}
          </button>
        ))}
      </div>

      {selected.length > 0 && (
        <>
          <div style={{ fontSize: 11, letterSpacing: "0.1em", textTransform: "uppercase", color: GOLD, marginBottom: 10 }}>
            Roughly how much?
          </div>
          <div style={{ display: "flex", flexDirection: "column", gap: 7, marginBottom: 16 }}>
            {LOAD_SIZES.map(opt => (
              <button key={opt.value} onClick={() => setSize(opt.value)} style={{
                background: size === opt.value ? GOLD : "transparent",
                color: size === opt.value ? BLACK : WHITE,
                border: `1px solid ${size === opt.value ? GOLD : BORDER}`,
                padding: "11px 16px", fontSize: 13.5, cursor: "pointer",
                textAlign: "left", borderRadius: 4, fontFamily: "inherit",
                fontWeight: size === opt.value ? 600 : 400,
                transition: "all 0.15s"
              }}>
                {opt.label}
              </button>
            ))}
          </div>
        </>
      )}

      {ready && (
        <button onClick={() => onConfirm(selected, size)} style={{
          background: GOLD, color: BLACK, border: "none",
          padding: "13px 24px", fontSize: 13.5, fontWeight: 700,
          cursor: "pointer", borderRadius: 4, fontFamily: "inherit",
          width: "100%", letterSpacing: "0.04em"
        }}>
          That's everything →
        </button>
      )}
    </div>
  );
}

