const SHEET_WEBHOOK_URL = "https://script.google.com/macros/s/AKfycbwBiCWO6c53DekDCzwdHHfNPC8ARQG-lBcKRs5ZqjQvLdnaNg-cINwXYvc-wwTOWbDW/exec";

function logLeadToSheet(data) {
  try {
    fetch(SHEET_WEBHOOK_URL, {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "text/plain" },
      body: JSON.stringify({
        name: data.name,
        area: data.area,
        junkTypes: Array.isArray(data.junkTypes) ? data.junkTypes.join(", ") : data.junkTypes,
        loadSize: data.loadSize,
        timeline: data.timeline,
        contactType: data.contactType,
        contact: data.contact,
      }),
    });
  } catch (err) {
    console.error("Lead logging failed:", err);
  }
}

function isQuestion(val) {
  const v = val.trim().toLowerCase();
  if (v.endsWith("?")) return true;
  const starters = ["why ", "how ", "what ", "when ", "who ", "is ", "are ", "do ", "did ", "can ", "will ", "does ", "tell me", "explain"];
  return starters.some(s => v.startsWith(s));
}

function cleanLocation(raw) {
  if (!raw) return "";
  let loc = raw.trim();
  const fillers = [
    /^i'?m\s+from\s+/i, /^from\s+/i, /^in\s+/i, /^out\s+of\s+/i,
    /^based\s+in\s+/i, /^living\s+in\s+/i, /^located\s+in\s+/i,
  ];
  for (const f of fillers) loc = loc.replace(f, "");
  loc = loc.trim().replace(/[.!?]+$/, "");
  loc = loc.split(/\s+/).map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(" ");
  return loc;
}

function parseNameArea(val) {
  const fromMatch = val.match(/^(.+?)\s+(?:and\s+)?(?:i'?m\s+)?(?:from|in|out of)\s+(.+)$/i);
  const commaMatch = val.match(/^([^,]+),\s*(.+)$/);
  if (fromMatch) {
    const name = fromMatch[1].trim().split(/\s+/)[0];
    return { name: name.charAt(0).toUpperCase() + name.slice(1).toLowerCase(), area: cleanLocation(fromMatch[2]) };
  }
  if (commaMatch) return { name: commaMatch[1].trim(), area: cleanLocation(commaMatch[2]) };
  const words = val.trim().split(/\s+/);
  if (words.length === 1) return { name: words[0], area: "" };
  return { name: words[0].charAt(0).toUpperCase() + words[0].slice(1).toLowerCase(), area: cleanLocation(words.slice(1).join(" ")) };
}

