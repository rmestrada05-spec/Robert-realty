  const [timeline, setTimeline] = useState(null);
  const [contactType, setContactType] = useState(null);
  const [contactVal, setContactVal] = useState("");

  const timelines = [
    { label: "As soon as possible", value: "asap" },
    { label: "This week", value: "week" },
    { label: "Within the month", value: "month" },
    { label: "Just planning ahead", value: "planning" },
  ];

  const ready = timeline && contactType && contactVal.trim();

  return (
    <div style={{ marginBottom: 16 }}>
      <div style={{ fontSize: 11, letterSpacing: "0.1em", textTransform: "uppercase", color: GOLD, marginBottom: 10 }}>
        How soon do you need it gone?
      </div>
      <div style={{ display: "flex", flexDirection: "column", gap: 7, marginBottom: 16 }}>
        {timelines.map(opt => (
          <button key={opt.value} onClick={() => setTimeline(opt.value)} style={{
            background: timeline === opt.value ? GOLD : "transparent",
            color: timeline === opt.value ? BLACK : WHITE,
            border: `1px solid ${timeline === opt.value ? GOLD : BORDER}`,
            padding: "11px 16px", fontSize: 13.5, cursor: "pointer",
            textAlign: "left", borderRadius: 4, fontFamily: "inherit",
            fontWeight: timeline === opt.value ? 600 : 400,
            transition: "all 0.15s"
          }}>
            {opt.label}
          </button>
        ))}
      </div>

      {timeline && (
        <>
          <div style={{ fontSize: 11, letterSpacing: "0.1em", textTransform: "uppercase", color: GOLD, marginBottom: 10 }}>
            Best way to reach you?
          </div>
          <div style={{ display: "flex", gap: 8, marginBottom: 12 }}>
            {[{ label: "Phone", value: "phone" }, { label: "Email", value: "email" }].map(opt => (
              <button key={opt.value} onClick={() => setContactType(opt.value)} style={{
                flex: 1, background: contactType === opt.value ? GOLD : "transparent",
                color: contactType === opt.value ? BLACK : WHITE,
                border: `1px solid ${contactType === opt.value ? GOLD : BORDER}`,
                padding: "11px 16px", fontSize: 13.5, cursor: "pointer",
                textAlign: "center", borderRadius: 4, fontFamily: "inherit",
                fontWeight: contactType === opt.value ? 600 : 400,
                transition: "all 0.15s"
              }}>
                {opt.label}
              </button>
            ))}
          </div>

          {contactType && (
            <div style={{ display: "flex", gap: 10, marginBottom: 12 }}>
              <input
                value={contactVal} onChange={e => setContactVal(e.target.value)}
                onKeyDown={e => { if (e.key === "Enter" && ready) onConfirm(timeline, contactType, contactVal.trim()); }}
                placeholder={contactType === "phone" ? "Your phone number" : "Your email address"}
                type={contactType === "phone" ? "tel" : "email"}
                autoFocus
                style={{
                  flex: 1, border: `1px solid ${BORDER}`, padding: "12px 16px",
                  fontSize: 14, outline: "none", borderRadius: 4,
                  fontFamily: "inherit", color: WHITE, background: DARK
                }}
              />
            </div>
          )}
        </>
      )}

      {ready && (
        <button onClick={() => onConfirm(timeline, contactType, contactVal.trim())} style={{
          background: GOLD, color: BLACK, border: "none",
          padding: "13px 24px", fontSize: 13.5, fontWeight: 700,
          cursor: "pointer", borderRadius: 4, fontFamily: "inherit",
          width: "100%", letterSpacing: "0.04em"
        }}>
          Send my request →
        </button>
      )}
    </div>
  );
}

export default function App() {
  const [step, setStep] = useState("intro");
  const [data, setData] = useState({
    name: "", area: "", junkTypes: [], loadSize: "",
    timeline: "", contactType: "", contact: ""
  });
  const [messages, setMessages] = useState([
    { type: "bot", text: "Hey — I'm Robert with Golden Strada Trailers. We haul just about anything: furniture, construction debris, concrete, dirt, yard waste, full cleanouts." },
    { type: "bot", text: "What's your name and what area are you in?" },
  ]);
  const [inputVal, setInputVal] = useState("");
  const [typing, setTyping] = useState(false);
  const bottomRef = useRef(null);

  function scrollDown() { setTimeout(() => bottomRef.current?.scrollIntoView({ behavior: "smooth" }), 50); }
  function addMsg(type, text) { setMessages(m => [...m, { type, text }]); scrollDown(); }
  async function botSay(text, delay = 700) {
    setTyping(true); scrollDown();
    await new Promise(r => setTimeout(r, delay));
    setTyping(false); addMsg("bot", text);
  }
  function enter(e, fn) { if (e.key === "Enter") fn(); }

  async function handleOffScript(question) {
    addMsg("user", question);
    setInputVal("");
    setTyping(true); scrollDown();
    try {
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 200,
          system: "You are Robert, owner of Golden Strada Trailers in Lancaster, CA. Full-service junk removal and waste hauling in the Antelope Valley. 12x8x4 hydraulic dump trailer, 14 cubic yards, 8,200 lbs payload. You haul furniture, appliances, yard waste, construction debris, concrete, dirt, rock — everything except hazardous materials. Service area: Lancaster, Palmdale, Littlerock, Antelope Acres, California City, Newhall, Santa Clarita corridor. Straight-talking, hardworking, no-nonsense. Answer briefly in 2 sentences max then ask them for their name and area.",
          messages: [{ role: "user", content: question }]
        })
      });
      const json = await res.json();
      const reply = json.content?.find(b => b.type === "text")?.text || "Good question — call us at (661) 802-1248 and we'll sort it out.";
      setTyping(false);
      addMsg("bot", reply);
    } catch {
      setTyping(false);
      addMsg("bot", "Good question — give us a call at (661) 802-1248 and we'll get you sorted.");
    }
    await new Promise(r => setTimeout(r, 300));
    addMsg("contact", "");
  }

  async function handleIntro() {
    if (!inputVal.trim()) return;
    const val = inputVal.trim();
    if (isQuestion(val)) { handleOffScript(val); return; }
    const { name, area } = parseNameArea(val);
    setData(d => ({ ...d, name, area }));
    setInputVal(""); addMsg("user", val);
    setStep("loading");
    if (area && area.length > 2) {
      await botSay(`Good to meet you, ${name}. What are we hauling and how much is there?`);
      setStep("junk");
    } else {
      await botSay(`Good to meet you, ${name} — what city or area are you in? We serve Lancaster and surrounding communities.`);
      setStep("area");
    }
  }

  async function handleArea() {
    if (!inputVal.trim()) return;
    const area = inputVal.trim();
    setData(d => ({ ...d, area }));
    setInputVal(""); addMsg("user", area);
    setStep("loading");
    await botSay(`Got it. What are we hauling and how much is there?`);
    setStep("junk");
  }

  async function handleJunk(junkTypes, loadSize) {
    const junkLabels = JUNK_TYPES.filter(j => junkTypes.includes(j.value)).map(j => j.label);
    const sizeLabel = LOAD_SIZES.find(s => s.value === loadSize)?.label || loadSize;
    setData(d => ({ ...d, junkTypes, loadSize }));
    addMsg("user", `${junkLabels.join(", ")} — ${sizeLabel}`);
    setStep("loading");
    await botSay(`Got it. Last thing — how soon do you need it gone, and what's the best way to reach you?`);
    setStep("timeline");
  }

  async function handleTimeline(timeline, contactType, contact) {
    const timelineLabel = {
      asap: "As soon as possible",
      week: "This week",
      month: "Within the month",
      planning: "Just planning ahead"
    }[timeline] || timeline;

    const finalData = { ...data, timeline, contactType, contact };
    setData(finalData);
    addMsg("user", `${timelineLabel} · ${contact}`);
    setStep("loading");
    logLeadToSheet(finalData);
    await botSay(`Perfect — Robert will reach out to confirm availability and give you a free estimate. We appreciate the call, ${data.name}.`, 800);
    setStep("done");
  }

  return (
    <div style={{
      background: "#080808", minHeight: "100vh",
      display: "flex", alignItems: "center", justifyContent: "center",
      padding: 24, fontFamily: "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    }}>
      <div style={{
        background: BLACK, width: "100%", maxWidth: 540,
        border: `1px solid ${BORDER}`, padding: "40px 36px 32px"
      }}>

        <div style={{ marginBottom: 28 }}>
          <div style={{ fontSize: 9, letterSpacing: "0.22em", textTransform: "uppercase", color: GRAY, marginBottom: 6 }}>
            Free Estimate
          </div>
          <div style={{ fontSize: 18, fontWeight: 700, color: GOLD, letterSpacing: "0.06em", textTransform: "uppercase", fontFamily: "Georgia, serif" }}>
            Golden Strada Trailers
          </div>
          <div style={{ fontSize: 11, color: GRAY, marginTop: 3, letterSpacing: "0.04em" }}>
            Antelope Valley Junk Removal · Lancaster, CA
          </div>
        </div>

        <div style={{ height: 1, background: `linear-gradient(to right, ${GOLD}, transparent)`, marginBottom: 28 }} />

        <div style={{ display: "flex", flexDirection: "column", gap: 8, marginBottom: 20 }}>
          {messages.map((m, i) => {
            if (m.type === "bot") return <BotBubble key={i} text={m.text} />;
            if (m.type === "contact") return <ContactBubble key={i} />;
            return <UserBubble key={i} text={m.text} />;
          })}
          {typing && <TypingIndicator />}

          {step === "done" && (
            <div style={{
              background: DARK, border: `1px solid ${GOLD}`,
              borderRadius: 4, padding: "18px 20px", marginTop: 8
            }}>
              <div style={{ fontSize: 10, letterSpacing: "0.14em", textTransform: "uppercase", color: GOLD, marginBottom: 8 }}>
                Request received
              </div>
              <div style={{ fontSize: 13.5, color: WHITE, lineHeight: 1.7 }}>
                We'll be in touch shortly with a free estimate. Questions in the meantime?
              </div>
              <div style={{ marginTop: 12, fontSize: 13.5, color: GOLD, fontWeight: 600 }}>
                📞 (661) 802-1248
              </div>
            </div>
          )}

          <div ref={bottomRef} />
        </div>

        {step === "intro" && (
          <TextInput
            val={inputVal} setVal={setInputVal}
            placeholder='e.g. "Mike, Lancaster"'
            onSubmit={handleIntro} onKey={e => enter(e, handleIntro)}
          />
        )}
        {step === "area" && (
          <TextInput
            val={inputVal} setVal={setInputVal}
            placeholder="City or neighborhood"
            onSubmit={handleArea} onKey={e => enter(e, handleArea)}
          />
        )}
        {step === "junk" && <JunkSelector onConfirm={handleJunk} />}
        {step === "timeline" && <TimelineContactSelector onConfirm={handleTimeline} />}

        <div style={{ height: 1, background: BORDER, margin: "20px 0 14px" }} />
        <div style={{ fontSize: 10, letterSpacing: "0.12em", textTransform: "uppercase", color: BORDER, textAlign: "center" }}>
          Golden Strada Trailers · (661) 802-1248
        </div>
      </div>
      <style>{`
        @keyframes bounce { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-5px)} }
        input::placeholder { color: #555; }
        input { color: #f5f5f5 !important; }
      `}</style>
    </div>
  );
}